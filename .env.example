#
# Local development environment. Copy to `.env` (git-ignored). None of these are
# required to run standalone on the LAN — the app degrades gracefully when the
# OpenMasjidOS Fabric, the tunnel, Stripe and mail are all absent (CLAUDE.md §6).
# There is deliberately no mail configuration: the platform owns the provider and
# this app holds no mail credentials (§7).

# Web port the server listens on (container port; the platform maps a host port).
PORT=8080

# Data volume: the SQLite database (WAL) and its half-hourly snapshots. That is the
# whole of the app's state — there are no attachments and no generated PDFs (§4:
# payment-proof uploads were never built; §7: no PDF renderer, the printable
# documents are print-CSS HTML). In dev this defaults to ./packages/server/data.
DATA_DIR=

# Where the built web UI is served from. Set in the container; leave BLANK in dev,
# where Vite serves the UI on :5173 and the server runs API-only.
PUBLIC_DIR=

# ── OpenMasjidOS Fabric (injected by the platform in production) ──────────────
# Read every process start; NEVER persisted to the data volume (restore-resilient).
# Leave blank for standalone LAN dev. Simulate the Cloudflare tunnel origin locally
# by sending a request header `cf-ray: dev` (exercises the admin-LAN-only policy).
OPENMASJID_BASE_URL=
OPENMASJID_APP_ID=
OPENMASJID_APP_SECRET=
OPENMASJID_PUBLIC_URL=

# ── Stripe (fetched over the Fabric in production; optional local override) ───
# The secret key is read server-side only and never sent to the browser or logged.
STRIPE_ACCOUNT=
CURRENCY=usd
SCHOOL_NAME=
